<?xml version="1.0" encoding="utf-8"?>
<!--
  audio_service resolves its notification icons by NAME at runtime
  (getIdentifier), which the resource shrinker cannot see. Without this the
  drawables are stripped from release builds and every playbackState update
  throws "You must specify an icon resource id to build a CustomAction",
  leaving the media session inactive and no notification on the lock screen.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_stat_bible" />
